# Copy to .env and fill in. Never commit .env.

# --- LLM providers -------------------------------------------------------
# Only the provider selected by DEFAULT_LLM is actually required.
# With the OpenAI default below, this one key does BOTH the reasoning
# (planner/generator/verifier) and the document embeddings.
OPENAI_API_KEY=
# Not needed unless you point DEFAULT_LLM at a claude-* model.
ANTHROPIC_API_KEY=

# --- Vector store --------------------------------------------------------
# Local Docker: http://localhost:6333 and leave QDRANT_API_KEY empty.
# Qdrant Cloud: https://<cluster-id>.<region>.cloud.qdrant.io:6333 plus its key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=research

# --- Web search ----------------------------------------------------------
TAVILY_API_KEY=

# --- Memory (optional) ---------------------------------------------------
MEM0_API_KEY=

# --- LangSmith tracing (optional) ---------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-research-system
# Opt in to sending document/memory CONTENT to LangSmith. Off by default.
TRACE_CONTENT=false

# --- Models --------------------------------------------------------------
# The reasoning model. Its name determines the provider, so an openai/* or
# gpt-* name here means OpenAI does the planning, answering and fact-checking.
DEFAULT_LLM=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Tunables ------------------------------------------------------------
MAX_RETRIEVAL_DOCS=10
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_TOP_K=5
WEB_RESULTS_PER_QUERY=3
FAITHFULNESS_THRESHOLD=0.7
MAX_VERIFICATION_RETRIES=2
TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
QDRANT_SCORE_THRESHOLD=0.3
RRF_K=60
MEMORY_SEARCH_LIMIT=3
